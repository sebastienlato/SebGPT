# Project-local Python environment
.venv/

# Python-generated files and tool caches
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebook-generated state
.ipynb_checkpoints/

# macOS metadata
.DS_Store

# Local datasets are ignored by default. The sole exception is the exact small
# Phase 1 Gutenberg master authorized by DEC-0008; processed data stays ignored.
data/*
!data/.gitkeep
!data/raw/
data/raw/*
!data/raw/gutenberg-ebook-100/
data/raw/gutenberg-ebook-100/*
!data/raw/gutenberg-ebook-100/complete-works.txt

# Model checkpoints and weights are never source-controlled
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.ckpt

# Generated experiment artifacts
experiments/**/artifacts/
